// Same CI/CD flow as Jenkinsfile_CICD, plus Slack notifications on start, success and failure.
// Requires the "Slack Notification" plugin configured as described in "Jenkins Slack Setup.md".

def notify(String color, String status) {
    slackSend(
        channel: '#auction-deployments',
        color: color,
        message: "*${status}*: ${env.JOB_NAME} #${env.BUILD_NUMBER}\n" +
                 "Branch: ${env.BRANCH_NAME ?: 'main'}\n" +
                 "<${env.BUILD_URL}|Open build>"
    )
}

pipeline {
    agent any

    tools { nodejs 'node20' }

    environment {
        DOCKERHUB_USER = credentials('dockerhub-creds')
        API_IMAGE      = "${DOCKERHUB_USER_USR}/auction-api"
        CLIENT_IMAGE   = "${DOCKERHUB_USER_USR}/auction-client"
        TAG            = "${env.BUILD_NUMBER}"
        NAMESPACE      = 'auction'
    }

    stages {
        stage('Notify Start') {
            steps { script { notify('#439FE0', 'STARTED') } }
        }

        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Test & Build') {
            parallel {
                stage('API tests') {
                    steps { dir('api') { sh 'npm ci && npm test' } }
                }
                stage('Client build') {
                    steps { dir('client') { sh 'npm ci && npm run build' } }
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                sh 'echo "$DOCKERHUB_USER_PSW" | docker login -u "$DOCKERHUB_USER_USR" --password-stdin'
                sh "docker build -t ${API_IMAGE}:${TAG} ./api && docker push ${API_IMAGE}:${TAG}"
                sh "docker build -t ${CLIENT_IMAGE}:${TAG} ./client && docker push ${CLIENT_IMAGE}:${TAG}"
            }
        }

        stage('Deploy') {
            when { branch 'main' }
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh '''
                        kubectl set image deployment/api    api=$API_IMAGE:$TAG       -n $NAMESPACE
                        kubectl set image deployment/client client=$CLIENT_IMAGE:$TAG -n $NAMESPACE
                        kubectl rollout status deployment/api    -n $NAMESPACE --timeout=180s
                        kubectl rollout status deployment/client -n $NAMESPACE --timeout=180s
                    '''
                }
            }
        }
    }

    post {
        success  { script { notify('good',    'SUCCESS') } }
        failure  { script { notify('danger',  'FAILED') } }
        unstable { script { notify('warning', 'UNSTABLE') } }
        always   { sh 'docker logout || true' }
    }
}
