// Full CI/CD pipeline: test -> scan -> build & push -> deploy to Kubernetes
// Jenkins credentials required:
//   dockerhub-creds  (Username/Password)  - Docker Hub username + access token
//   kubeconfig       (Secret file)        - kubeconfig for the target cluster
//   auction-db-pass, auction-root-pass, auction-jwt  (Secret text)
// Tools: NodeJS plugin (tool name "node20"), Docker on the agent, kubectl, trivy

pipeline {
    agent any

    tools { nodejs 'node20' }

    environment {
        DOCKERHUB_USER = credentials('dockerhub-creds')   // exposes _USR and _PSW
        API_IMAGE      = "${DOCKERHUB_USER_USR}/auction-api"
        CLIENT_IMAGE   = "${DOCKERHUB_USER_USR}/auction-client"
        TAG            = "${env.BUILD_NUMBER}"
        NAMESPACE      = 'auction'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Test API') {
            steps {
                dir('api') {
                    sh 'npm ci'
                    sh 'npm test'
                }
            }
        }

        stage('Build Client') {
            steps {
                dir('client') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh 'trivy fs --severity HIGH,CRITICAL --format table -o trivy-fs.txt .'
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -t ${API_IMAGE}:${TAG} -t ${API_IMAGE}:latest ./api"
                sh "docker build -t ${CLIENT_IMAGE}:${TAG} -t ${CLIENT_IMAGE}:latest ./client"
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh "trivy image --severity HIGH,CRITICAL --format table -o trivy-api.txt ${API_IMAGE}:${TAG}"
                sh "trivy image --severity HIGH,CRITICAL --format table -o trivy-client.txt ${CLIENT_IMAGE}:${TAG}"
            }
        }

        stage('Docker Push') {
            steps {
                sh 'echo "$DOCKERHUB_USER_PSW" | docker login -u "$DOCKERHUB_USER_USR" --password-stdin'
                sh "docker push ${API_IMAGE}:${TAG} && docker push ${API_IMAGE}:latest"
                sh "docker push ${CLIENT_IMAGE}:${TAG} && docker push ${CLIENT_IMAGE}:latest"
            }
        }

        stage('Deploy to Kubernetes') {
            when { branch 'main' }
            steps {
                withCredentials([
                    file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG'),
                    string(credentialsId: 'auction-db-pass',   variable: 'DB_PASS'),
                    string(credentialsId: 'auction-root-pass', variable: 'ROOT_PASS'),
                    string(credentialsId: 'auction-jwt',       variable: 'JWT')
                ]) {
                    sh '''
                        kubectl apply -f k8s-prod/namespace.yaml
                        kubectl apply -f k8s-prod/sc.yaml
                        kubectl create secret generic auction-secrets -n $NAMESPACE \
                          --from-literal=MYSQL_ROOT_PASSWORD="$ROOT_PASS" \
                          --from-literal=DB_PASSWORD="$DB_PASS" \
                          --from-literal=JWT_SECRET="$JWT" \
                          --dry-run=client -o yaml | kubectl apply -f -
                        kubectl apply -f k8s-prod/configmap.yaml
                        kubectl create configmap mysql-init -n $NAMESPACE \
                          --from-file=init.sql=mysql-init/init.sql --dry-run=client -o yaml | kubectl apply -f -
                        kubectl apply -f k8s-prod/mysql.yaml

                        sed -i "s|DOCKERHUB_USERNAME/auction-api:latest|$API_IMAGE:$TAG|" k8s-prod/api.yaml
                        sed -i "s|DOCKERHUB_USERNAME/auction-client:latest|$CLIENT_IMAGE:$TAG|" k8s-prod/client.yaml
                        kubectl apply -f k8s-prod/api.yaml
                        kubectl apply -f k8s-prod/client.yaml

                        kubectl rollout status deployment/api -n $NAMESPACE --timeout=180s
                        kubectl rollout status deployment/client -n $NAMESPACE --timeout=180s
                        kubectl get svc,pods -n $NAMESPACE -o wide
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'trivy-*.txt', allowEmptyArchive: true
            sh 'docker logout || true'
        }
    }
}
